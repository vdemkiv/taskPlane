{
  "schema": "taskplane.eval-scenario/v1",
  "skill": "tp-build",
  "title": "The new-feature flow: a requirement scored, the graph told about it, and the builder shown the blast radius BEFORE the code changes",
  "source_files": [
    "skills/tp-build/SKILL.md"
  ],
  "inputs_fingerprint": "9beb6d89f401295345592ebf4e95611a6fc0a971a4f61f6a656be4f5fc6dc2d9",
  "expects_derivations": [
    "impact",
    "graph_scan"
  ],
  "declared_surfaces": [
    "tp req new",
    "tp req score",
    "tp graph scan",
    "tp loop init"
  ],
  "steps": [
    {
      "id": "U1-CONTRACT",
      "claim": "the run was governed before it changed anything — the contract was active before the first write, not declared after the fact",
      "record": "trace",
      "check": "before",
      "select": {
        "event": "contract_activated"
      },
      "before": "first_write",
      "universal": [
        "contract"
      ],
      "required": true
    },
    {
      "id": "U2-DOR",
      "claim": "readiness was established before the work started — a DoR that passed, ahead of the first write",
      "record": "trace",
      "check": "before",
      "select": {
        "event": "dor",
        "ready": true
      },
      "before": "first_write",
      "universal": [
        "dor"
      ],
      "required": true
    },
    {
      "id": "U3-DOD",
      "claim": "the definition of done was checked before anything claimed the work was finished",
      "record": "trace",
      "check": "before",
      "select": {
        "event": "dod",
        "passed": true
      },
      "before": "completion_claim",
      "universal": [
        "dod"
      ],
      "required": true
    },
    {
      "id": "U4-SHARED",
      "claim": "nothing expensive was derived twice — the diff, the blast radius and the graph scan were each computed once and shared",
      "record": "derivations",
      "check": "repeats",
      "select": {
        "event": "derived",
        "probe": {
          "absent": true
        }
      },
      "distinct_by": [
        "key",
        "input_key"
      ],
      "max": 0,
      "universal": [
        "no_rederive"
      ],
      "required": true
    }
  ]
}
