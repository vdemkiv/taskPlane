{
  "schema": "taskplane.skill-flow/v1",
  "skill": "taskplane",
  "approval": {
    "status": "human-approved",
    "scope": "native source review simplification",
    "date": "2026-09-14"
  },
  "settings": {
    "source": "taskplane/operational-settings.json",
    "loader": "taskplane.settings.load_settings",
    "binding": "settings_digest"
  },
  "stage_runtime": {
    "dispatch_schema": "taskplane.stage-dispatch/v1",
    "startup_schema": "taskplane.stage-startup/v1",
    "handoff_schema": "taskplane.stage-handoff/v1",
    "bounded_inputs": [
      "authority",
      "input_handoff",
      "selected_artifacts",
      "budget",
      "declared_scope",
      "execution_claim"
    ],
    "forbidden_inheritance": [
      "agents",
      "conversations",
      "event_logs",
      "tool_transcripts",
      "leases",
      "runtime_state",
      "predecessor_roots"
    ],
    "non_build_terminal_outcomes": [
      "closed",
      "discarded"
    ],
    "implicit_build": false,
    "default": "taskplane.run/v4",
    "applies_to": "explicit delivery only"
  },
  "nodes": [
    {
      "id": "goal",
      "label": "user goal",
      "kind": "input"
    },
    {
      "id": "route",
      "label": "intent + state route",
      "kind": "control"
    },
    {
      "id": "help",
      "label": "help / setup",
      "kind": "branch"
    },
    {
      "id": "status",
      "label": "status snapshot",
      "kind": "branch"
    },
    {
      "id": "product",
      "label": "define WHAT",
      "kind": "branch"
    },
    {
      "id": "design",
      "label": "settle HOW",
      "kind": "branch"
    },
    {
      "id": "build",
      "label": "build feature",
      "kind": "branch"
    },
    {
      "id": "terminal_handoff",
      "label": "done / closed / discarded (no implicit Build)",
      "kind": "stage"
    },
    {
      "id": "review",
      "label": "native source review and direct findings",
      "kind": "branch"
    },
    {
      "id": "signoff",
      "label": "human approve / request changes",
      "kind": "gate"
    }
  ],
  "edges": [
    [
      "route",
      "help"
    ],
    [
      "route",
      "status"
    ],
    [
      "route",
      "product"
    ],
    [
      "route",
      "design"
    ],
    [
      "route",
      "build"
    ],
    [
      "route",
      "review"
    ],
    [
      "product",
      "terminal_handoff"
    ],
    [
      "design",
      "terminal_handoff"
    ],
    [
      "goal",
      "route"
    ],
    [
      "build",
      "signoff"
    ]
  ]
}
