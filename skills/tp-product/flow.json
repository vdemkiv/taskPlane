{
  "schema": "taskplane.skill-flow/v1",
  "skill": "tp-product",
  "approval": {
    "status": "human-approved",
    "scope": "all-10",
    "date": "2026-08-14"
  },
  "settings": {
    "source": "taskplane/operational-settings.json",
    "loader": "taskplane.settings.load_settings",
    "binding": "settings_digest"
  },
  "stage_runtime": {
    "dispatch_schema": "taskplane.stage-dispatch/v1",
    "startup_schema": "taskplane.stage-startup/v1",
    "handoff_schema": "taskplane.stage-handoff/v1",
    "bounded_inputs": [
      "authority",
      "input_handoff",
      "selected_artifacts",
      "budget",
      "declared_scope",
      "execution_claim"
    ],
    "forbidden_inheritance": [
      "agents",
      "conversations",
      "event_logs",
      "tool_transcripts",
      "leases",
      "runtime_state",
      "predecessor_roots"
    ],
    "non_build_terminal_outcomes": [
      "closed",
      "discarded"
    ],
    "implicit_build": false,
    "default": "taskplane.run/v4"
  },
  "nodes": [
    {
      "id": "idea",
      "label": "idea / change request",
      "kind": "input"
    },
    {
      "id": "context",
      "label": "product context + scoped operation readiness",
      "kind": "stage"
    },
    {
      "id": "requirement",
      "label": "complete R-record",
      "kind": "stage"
    },
    {
      "id": "contracts",
      "label": "contracts + dependencies",
      "kind": "stage"
    },
    {
      "id": "dor",
      "label": "explicit Product content and operation DoR",
      "kind": "parallel"
    },
    {
      "id": "review",
      "label": "minimum-sufficient quick route + 26 dispositions",
      "kind": "stage"
    },
    {
      "id": "approval",
      "label": "Product DoD evidence + applicable human disposition",
      "kind": "gate"
    },
    {
      "id": "build",
      "label": "trigger governed Build",
      "kind": "stage"
    },
    {
      "id": "terminal_handoff",
      "label": "retained result + exact standalone finish; no implicit Build",
      "kind": "stage"
    }
  ],
  "edges": [
    [
      "idea",
      "context"
    ],
    [
      "context",
      "requirement"
    ],
    [
      "requirement",
      "contracts"
    ],
    [
      "contracts",
      "dor"
    ],
    [
      "dor",
      "review"
    ],
    [
      "review",
      "approval"
    ],
    [
      "approval",
      "build"
    ],
    [
      "approval",
      "terminal_handoff"
    ]
  ]
}
