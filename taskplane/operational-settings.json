{
  "build": {
    "concurrency": "native",
    "shards": 1
  },
  "cleanup": {
    "artifacts_days": 30,
    "worktrees": "after-merge"
  },
  "dashboard": {
    "refresh": {
      "lifecycle_events": [
        "gate",
        "submit",
        "next_action",
        "approve",
        "select",
        "resolve",
        "replan",
        "handle_host_input",
        "cleanup_replay",
        "retro",
        "worker_terminal",
        "terminalize_run"
      ],
      "replay_on_session_start": true,
      "session_event": "session_recovery"
    }
  },
  "lenses": {
    "counts": {
      "build": 0,
      "design": 16,
      "engineering": 0,
      "evaluate": 0,
      "fix": 0,
      "plan": 4,
      "product": 3,
      "retro": 0
    },
    "routing": {
      "build": [],
      "design": [
        "solution-design"
      ],
      "engineering": [],
      "evaluate": [],
      "fix": [],
      "plan": [
        "architecture",
        "project-management",
        "testability"
      ],
      "product": [
        "product"
      ],
      "retro": []
    }
  },
  "limits": {
    "budgets": {
      "lens_deep_max_actions": 45,
      "lens_sweep_max_actions": 30,
      "max_actions": 60,
      "max_cost_usd": null,
      "max_tokens": 17000000,
      "target_tokens": 12000000
    },
    "timeouts": {
      "lens_minimum_wait_seconds": 300,
      "lens_wait_seconds": 1800,
      "subprocess_seconds": 300,
      "task_seconds": 1800,
      "wait_seconds": 60
    }
  },
  "observability": {
    "include_values": false,
    "receipt": true
  },
  "overrides": {
    "governance_paths": [
      "lenses.*",
      "build.concurrency",
      "tests.backend",
      "workflow.*",
      "cleanup.*",
      "runtime.audit_every",
      "runtime.orphan_ttl_seconds",
      "runtime.obligations",
      "runtime.runnability",
      "runtime.review_max_attempts"
    ],
    "safe_paths": [
      "stages.*.model",
      "stages.*.reasoning",
      "build.shards",
      "tests.selection",
      "tests.shards",
      "tests.cache",
      "tests.cache_max_age_seconds",
      "runtime.inline_max_bytes",
      "limits.timeouts.*",
      "limits.budgets.*"
    ]
  },
  "phase_definitions": [],
  "runtime": {
    "audit_every": 5,
    "inline_max_bytes": 24000,
    "obligations": "enforce",
    "orphan_ttl_seconds": 3600,
    "review_max_attempts": 2,
    "runnability": "probe"
  },
  "schema": "taskplane.operational-settings/v2",
  "stages": {
    "build": {
      "model": "inherit",
      "reasoning": "high"
    },
    "design": {
      "model": "inherit",
      "reasoning": "high"
    },
    "engineering": {
      "model": "inherit",
      "reasoning": "high"
    },
    "evaluate": {
      "model": "inherit",
      "reasoning": "high"
    },
    "fix": {
      "model": "inherit",
      "reasoning": "high"
    },
    "plan": {
      "model": "inherit",
      "reasoning": "high"
    },
    "product": {
      "model": "inherit",
      "reasoning": "high"
    },
    "retro": {
      "model": "inherit",
      "reasoning": "high"
    }
  },
  "tests": {
    "backend": "ci",
    "cache": true,
    "cache_max_age_seconds": 86400,
    "selection": "targeted",
    "shards": 1
  },
  "workflow": {
    "root_session": {
      "resume": "forbidden",
      "root_budget_tokens": 40000000,
      "seed": "digest-only",
      "seed_budget_tokens": 40000
    },
    "transport": "native",
    "worker_inheritance": {
      "context": "none",
      "model": true,
      "reasoning": true
    }
  }
}
