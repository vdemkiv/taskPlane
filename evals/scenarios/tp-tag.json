{
  "schema": "taskplane.eval-scenario/v1",
  "skill": "tp-tag",
  "title": "Governed work inside Claude Tag: the same loop in an ephemeral sandbox, with gates answered by real people replying in the thread",
  "source_files": [
    "skills/tp-tag/SKILL.md"
  ],
  "inputs_fingerprint": "42a47aaef5ca7c1e63aba7510a38e56b6e76661bc7d187921eaf49a5beb41884",
  "expects_derivations": [
    "impact"
  ],
  "declared_surfaces": [
    "tp loop gate",
    "tp loop submit",
    "tp share push",
    "tp share set"
  ],
  "terminal": "completion",
  "steps": [
    {
      "id": "U1-CONTRACT",
      "claim": "the run was governed before it changed anything — the contract was active before the first write, not declared after the fact",
      "record": "trace",
      "check": "before",
      "select": {
        "event": "contract_activated"
      },
      "before": "first_write",
      "universal": [
        "contract"
      ],
      "required": true
    },
    {
      "id": "U2-DOR",
      "claim": "readiness was established before the work started — a DoR that passed, ahead of the first write",
      "record": "trace",
      "check": "before",
      "select": {
        "event": "dor",
        "ready": true
      },
      "before": "first_write",
      "universal": [
        "dor"
      ],
      "required": true
    },
    {
      "id": "U3-DOD",
      "claim": "the definition of done was checked before anything claimed the work was finished",
      "record": "trace",
      "check": "before",
      "select": {
        "event": "dod",
        "passed": true
      },
      "before": "completion_claim",
      "universal": [
        "dod"
      ],
      "required": true
    },
    {
      "id": "U4-SHARED",
      "claim": "nothing expensive was derived twice — the diff, the blast radius and the graph scan were each computed once and shared",
      "record": "derivations",
      "check": "repeats",
      "select": {
        "event": "derived",
        "probe": {
          "absent": true
        }
      },
      "distinct_by": [
        "key",
        "input_key"
      ],
      "max": 0,
      "universal": [
        "no_rederive"
      ],
      "required": true
    }
  ]
}
