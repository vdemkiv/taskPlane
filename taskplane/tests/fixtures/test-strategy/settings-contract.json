{
  "purpose": "Synthetic schema-validation input, not Product/Design acceptance or native-host evidence.",
  "strategy": {
    "schema": "taskplane.test-strategy/v1",
    "acceptance_criteria": [
      {
        "id": "AC-CONTRACT",
        "selectors": [
          "taskplane/tests/test_test_strategy_contract.py::test_strategy_validates_contract_and_refuses_nonexact_selector"
        ]
      },
      {
        "id": "AC-DASHBOARD",
        "selectors": [
          "taskplane/tests/test_dashboard_stage_graph_provenance.py::test_durable_html_graph_comes_from_snapshot_after_workspace_mutation"
        ]
      }
    ],
    "producers": [
      {
        "id": "dashboard:canonical-snapshot",
        "path": "taskplane/host_native.py",
        "slice": "DASHBOARD-CONTRACT",
        "consumers": [
          "taskplane/dashboard.py",
          "hooks/host_native_runtime.py",
          "taskplane/views.py"
        ],
        "freshness_inputs": [
          "source",
          "settings",
          "snapshot",
          "runner",
          "environment"
        ],
        "severed_edges": [
          {
            "consumer": "taskplane/dashboard.py",
            "mutation": "drop bound provenance while rendering the canonical snapshot",
            "selector": "taskplane/tests/test_host_native_publication.py::test_complete_binding_is_visible_and_identical_in_native_projection"
          }
        ],
        "interface_fixtures": [
          {
            "path": "taskplane/tests/fixtures/dashboard-contract/snapshot-v1.json",
            "slice": "DASHBOARD-CONTRACT"
          }
        ]
      },
      {
        "id": "dashboard:phase-graphs",
        "path": "taskplane/dashboard.py",
        "slice": "DASHBOARD-PROJECTION",
        "consumers": [
          "taskplane/views.py",
          "taskplane/host_native.py"
        ],
        "freshness_inputs": [
          "design-graph",
          "plan-dag",
          "waves",
          "module-impact",
          "selector"
        ],
        "severed_edges": [
          {
            "consumer": "taskplane/views.py",
            "mutation": "reopen mutable workspace state instead of rendering the sealed graph",
            "selector": "taskplane/tests/test_dashboard_stage_graph_provenance.py::test_durable_html_graph_comes_from_snapshot_after_workspace_mutation"
          }
        ],
        "interface_fixtures": [
          {
            "path": "taskplane/tests/fixtures/dashboard-phase/design-contract.json",
            "slice": "DASHBOARD-PROJECTION"
          },
          {
            "path": "taskplane/tests/fixtures/dashboard-phase/plan-tasks.json",
            "slice": "DASHBOARD-PROJECTION"
          },
          {
            "path": "taskplane/tests/fixtures/dashboard-phase/module-impact.json",
            "slice": "DASHBOARD-PROJECTION"
          }
        ]
      },
      {
        "id": "dashboard:publication",
        "path": "taskplane/views.py",
        "slice": "DASHBOARD-DELIVERY",
        "consumers": [
          "Codex native panel",
          "Claude native panel",
          "static HTML",
          "dashboard publication receipt"
        ],
        "freshness_inputs": [
          "event",
          "revision",
          "snapshot",
          "artifact",
          "graph",
          "host-acknowledgement"
        ],
        "severed_edges": [
          {
            "consumer": "static HTML",
            "mutation": "leave stale page actionable after publisher failure",
            "selector": "taskplane/tests/test_host_native_publication.py::test_delayed_prior_run_and_wrong_expected_head_cannot_replace_current"
          }
        ],
        "interface_fixtures": [
          {
            "path": "taskplane/tests/fixtures/dashboard-browser/environment.json",
            "slice": "DASHBOARD-DELIVERY"
          },
          {
            "path": "taskplane/tests/fixtures/dashboard-browser/topology.json",
            "slice": "DASHBOARD-DELIVERY"
          }
        ]
      }
    ],
    "failure_policy": {
      "classes": [
        "product",
        "test",
        "infrastructure",
        "environment"
      ],
      "correction_requires": [
        "class",
        "reason",
        "owner",
        "cluster"
      ]
    },
    "validation": {
      "layers": [
        "static",
        "exact-selector",
        "changed-radius",
        "proportional-suite",
        "authoritative-ci"
      ],
      "fingerprint_inputs": [
        "source",
        "tests",
        "settings",
        "inventory",
        "selector",
        "radius",
        "shard-plan",
        "runner",
        "environment"
      ],
      "reuse_unchanged_green": "cite",
      "broad_local_default": "refuse",
      "authoritative_matrix_runs": 1
    }
  }
}
