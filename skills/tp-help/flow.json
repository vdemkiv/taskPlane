{
  "schema": "taskplane.skill-flow/v1",
  "skill": "tp-help",
  "approval": {
    "status": "human-approved",
    "scope": "native source review simplification",
    "date": "2026-09-14"
  },
  "settings": {
    "source": "taskplane/operational-settings.json",
    "loader": "taskplane.settings.load_settings",
    "binding": "settings_digest"
  },
  "nodes": [
    {
      "id": "ask",
      "label": "help question",
      "kind": "input"
    },
    {
      "id": "answer",
      "label": "relevant documentation and concise answer",
      "kind": "stage"
    },
    {
      "id": "setup",
      "label": "diagnostics only for an explicit setup request",
      "kind": "stage"
    }
  ],
  "edges": [
    [
      "ask",
      "answer"
    ],
    [
      "ask",
      "setup"
    ]
  ]
}
