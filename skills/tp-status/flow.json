{
  "schema": "taskplane.skill-flow/v1",
  "skill": "tp-status",
  "approval": {
    "status": "human-approved",
    "scope": "native source review simplification",
    "date": "2026-09-14"
  },
  "settings": {
    "source": "taskplane/operational-settings.json",
    "loader": "taskplane.settings.load_settings",
    "binding": "settings_digest"
  },
  "stage_runtime": {
    "dispatch_schema": "taskplane.stage-dispatch/v1",
    "startup_schema": "taskplane.stage-startup/v1",
    "handoff_schema": "taskplane.stage-handoff/v1",
    "bounded_inputs": [
      "authority",
      "input_handoff",
      "selected_artifacts",
      "budget",
      "declared_scope",
      "execution_claim"
    ],
    "forbidden_inheritance": [
      "agents",
      "conversations",
      "event_logs",
      "tool_transcripts",
      "leases",
      "runtime_state",
      "predecessor_roots"
    ],
    "non_build_terminal_outcomes": [
      "closed",
      "discarded"
    ],
    "implicit_build": false,
    "default": "taskplane.run/v4",
    "applies_to": "explicit delivery only"
  },
  "nodes": [
    {
      "id": "request",
      "label": "status request",
      "kind": "input"
    },
    {
      "id": "manifest",
      "label": "delivery details only when requested",
      "kind": "parallel"
    },
    {
      "id": "state",
      "label": "loop + task state",
      "kind": "parallel"
    },
    {
      "id": "requirements",
      "label": "requirements + debt",
      "kind": "parallel"
    },
    {
      "id": "graph",
      "label": "dependency graph",
      "kind": "parallel"
    },
    {
      "id": "view",
      "label": "mission-control dashboard",
      "kind": "visual"
    },
    {
      "id": "action",
      "label": "action banner / no action",
      "kind": "stage"
    },
    {
      "id": "summary",
      "label": "native status or one saved summary",
      "kind": "stage"
    },
    {
      "id": "answer",
      "label": "current state and any needed action",
      "kind": "stage"
    }
  ],
  "edges": [
    [
      "manifest",
      "view"
    ],
    [
      "state",
      "view"
    ],
    [
      "requirements",
      "view"
    ],
    [
      "graph",
      "view"
    ],
    [
      "view",
      "action"
    ],
    [
      "request",
      "summary"
    ],
    [
      "summary",
      "answer"
    ],
    [
      "summary",
      "manifest"
    ],
    [
      "manifest",
      "state"
    ],
    [
      "manifest",
      "requirements"
    ],
    [
      "manifest",
      "graph"
    ]
  ]
}
