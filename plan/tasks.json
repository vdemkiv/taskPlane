{
  "tasks": [
    {
      "id": "t1-durable-command-runtime",
      "title": "Build the durable command lifecycle and deterministic state tests",
      "scope": [
        "taskplane/command_runtime.py",
        "taskplane/run_store.py",
        "taskplane/tests/test_command_runtime.py"
      ],
      "tests": "python3 -m pytest -q taskplane/tests/test_command_runtime.py",
      "req": "R-0007",
      "deps": [],
      "type": "architecture",
      "contracts": [
        "contract:runtime:command-state/v1",
        "contract:runtime:host-command-adapter",
        "contract:runtime:command-wave/v1",
        "contract:runtime:command-efficiency/v1"
      ],
      "new_modules": [
        "taskplane/command_runtime.py",
        "taskplane/run_store.py",
        "contract:runtime:command-state/v1",
        "contract:runtime:host-command-adapter",
        "contract:runtime:command-wave/v1",
        "contract:runtime:command-efficiency/v1"
      ],
      "design_edges": [
        "taskplane/command_runtime.py->contract:runtime:command-state/v1:provides",
        "taskplane/command_runtime.py->contract:runtime:host-command-adapter:consumes",
        "taskplane/command_runtime.py->contract:runtime:command-wave/v1:provides",
        "taskplane/command_runtime.py->contract:runtime:command-efficiency/v1:provides",
        "taskplane/run_store.py->contract:runtime:command-state/v1:references"
      ],
      "impact_policy": {
        "local_depth": 3,
        "boundary_mode": "contract-only",
        "contract_depth": 1,
        "requirement_depth": 1
      },
      "criteria": [
        "AC1: A silent command running for at least five minutes causes zero model turns between launch and its first meaningful state change.",
        "AC2: Normal completion causes exactly one model wake-up with a structured result.",
        "AC3: Failure, cancellation, timeout, and approval-needed states each cause exactly one wake-up.",
        "AC4: Identical or unchanged output is never written into the conversation.",
        "AC5: Large output is stored once as an artifact; the model receives only a bounded summary and reference.",
        "AC6: A user message interrupts an active wait without terminating or duplicating the command.",
        "AC7: Restarting or resuming a task reconnects to the existing command rather than executing it again.",
        "AC14: Existing timeout, cancellation, audit, and failure-reporting behavior remains fail-safe."
      ]
    },
    {
      "id": "t2-host-command-adapters",
