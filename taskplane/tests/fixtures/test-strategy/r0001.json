  "producers": [
    {
      "id": "dashboard:canonical-snapshot",
      "path": "taskplane/host_native.py",
      "slice": "DASHBOARD-CONTRACT",
      "consumers": ["taskplane/dashboard.py", "hooks/host_native_runtime.py", "taskplane/views.py"],
      "freshness_inputs": ["source", "settings", "snapshot", "runner", "environment"],
      "severed_edges": [
        {
          "consumer": "taskplane/dashboard.py",
          "mutation": "delete snapshot-to-dashboard call",
          "selector": "taskplane/tests/test_r0001_dashboard_pipeline.py::test_committed_events_publish_fresh_snapshot"
        }
      ],
      "interface_fixtures": [
        {"path": "taskplane/tests/fixtures/test-strategy/dashboard-snapshot.json", "slice": "DASHBOARD-CONTRACT"}
      ]
    },
    {
      "id": "dashboard:phase-graphs",
      "path": "taskplane/dashboard.py",
      "slice": "DASHBOARD-PROJECTION",
      "consumers": ["taskplane/views.py", "taskplane/host_native.py"],
      "freshness_inputs": ["design-graph", "plan-dag", "waves", "module-impact", "selector"],
      "severed_edges": [
        {
          "consumer": "taskplane/views.py",
          "mutation": "replace executable graph projection with metadata-only presence",
          "selector": "taskplane/tests/test_dashboard_phase_graphs.py::test_design_plan_and_impact_graphs_remain_distinct"
        }
      ],
      "interface_fixtures": [
        {"path": "taskplane/tests/fixtures/test-strategy/dashboard-phase-graphs.json", "slice": "DASHBOARD-PROJECTION"}
      ]
    },
    {
      "id": "dashboard:publication",
      "path": "taskplane/views.py",
      "slice": "DASHBOARD-DELIVERY",
      "consumers": ["Codex native panel", "Claude native panel", "static HTML", "dashboard publication receipt"],
      "freshness_inputs": ["event", "revision", "snapshot", "artifact", "graph", "host-acknowledgement"],
      "severed_edges": [
        {
          "consumer": "static HTML",
          "mutation": "leave stale page actionable after publisher failure",
          "selector": "taskplane/tests/test_dashboard_delivery_html.py::test_stale_publication_is_read_only"
        }
      ],
      "interface_fixtures": [
        {"path": "taskplane/tests/fixtures/test-strategy/dashboard-publication.json", "slice": "DASHBOARD-DELIVERY"}
      ]
    },
    {
      "id": "validation:test-strategy",
      "path": "taskplane/test_strategy.py",
      "slice": "TEST-STRATEGY",
      "consumers": ["Design acceptance map", "Plan tasks", "all Build slices", "CI policy", "ci_failure_batching.py", "portfolio ledger", "Evaluate evidence", "Engineering evidence"],
      "freshness_inputs": ["acceptance-criteria", "selectors", "producer", "consumer", "fixture", "freshness", "severed-edge", "radius", "runner", "browser-environment", "failure-class"],
      "severed_edges": [
        {
          "consumer": "all Build slices",
          "mutation": "delete producer/consumer edge",
          "selector": "taskplane/tests/test_test_strategy_contract.py::test_design_and_build_contract_is_complete"
        }
      ],
      "interface_fixtures": [
        {"path": "taskplane/tests/fixtures/test-strategy/r0001.json", "slice": "TEST-STRATEGY"}
      ]
    }
  ],
  "failure_policy": {
    "classes": ["product", "test", "infrastructure", "environment"],
    "correction_requires": ["class", "reason", "owner", "cluster"]
  },
  "validation": {
    "layers": ["static", "exact-selector", "changed-radius", "proportional-suite", "authoritative-ci"],
    "fingerprint_inputs": ["source", "tests", "settings", "inventory", "selector", "radius", "shard-plan", "runner", "environment"],
    "reuse_unchanged_green": "cite",
    "broad_local_default": "refuse",
    "authoritative_matrix_runs": 1
  }
}
