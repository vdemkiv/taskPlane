# taskplane governance (local state + review scratch)
.taskplane/
.em-review/
.eval/
# python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
# OS
.DS_Store

cleanup.sh
reset-history.sh

# taskplane knowledge base — private data lives under ignored .taskplane/
/knowledge/
# taskplane runtime (local-only — see docs/state-spec.md)
.security-review/
.tp-work/

# built distribution artifact (packaged via SendUserFile / device)
taskplane.plugin

# OpenAI marketplace upload artifacts (generated by scripts/package_openai.py)
/dist/
/build/
# Legacy packaging defaults may write release bundles at the repository root.
/taskplane-*.zip
/taskplane-*.zip.sha256
/taskplane-*.zip.provenance.json
/taskplane-*.plugin
/taskplane-*.plugin.sha256
/taskplane-*.plugin.provenance.json

# Local exports requested from Codex tasks (logs, reports, downloadable bundles)
/exports/

# Release-review scratch trees and one-off merge-wave artifacts never ship.
/_incoming-*/
/.fixwave/
/_to_delete/

# one-off local packaging scratch (never repository content)
/codex-wave.tar

# local Claude session settings (never commit)
.claude/

# graph-accuracy corpus scratch (each fixture scans into its own store)
/corpus/*/.tp-accuracy-home/

# Local planning scratch — specs not yet promoted into a governed track.
/backlog/
/design/backlog/

# Retain local analysis inputs/results without publishing them as source.
/analysis/
/reports/
/artifacts/
/test-results/
/coverage.xml

# Completed delivery runs belong in ignored execution storage.
/waves/
/Claude outputs/
/plan/
/design/contract.json
/design/design.md
/design/test-strategy.json
/design/lens-evidence/
/design/lenses/
/design/visual.html
/design/readiness.md
