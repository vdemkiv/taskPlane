{
  "schema": "taskplane.eval-scenario/v1",
  "skill": "tp-engineering",
  "title": "A governed engineering review: one pinned target, one graph-qualified envelope, selective leased slots, one canonical collection",
  "source_files": [
    "skills/tp-engineering/SKILL.md",
    "skills/tp-engineering/flow.json",
    "agents/tp-engineering.md"
  ],
  "inputs_fingerprint": "b158d5a4db7f3ce7b32052d63555daea9888bf204802354c051e062173ec7511",
  "expects_derivations": [
    "diff",
    "impact"
  ],
  "declared_surfaces": [
    "tp review start",
    "tp review collect",
    "tp review signoff",
    "tp graph impact",
    "tp findings"
  ],
  "terminal": "human_gate",
  "steps": [
    {
      "id": "R1",
      "claim": "the canonical review target is pinned to the exact head the evaluation names",
      "record": "context",
      "check": "field_equals",
      "select": {"kind": "target"},
      "field": "head",
      "equals": {"record": "run", "field": "target_head"},
      "required": true
    },
    {
      "id": "R2",
      "claim": "graph quality is complete for that pinned head before the ReviewKernel can dispatch",
      "record": "trace",
      "check": "all",
      "of": [
        {
          "check": "field_equals",
          "select": {"event": "review_kernel_started"},
          "field": "target_head",
          "equals": {"record": "context", "select": {"kind": "target"}, "field": "head"}
        },
        {
          "check": "field_equals",
          "select": {"event": "review_kernel_started"},
          "field": "graph_quality_status",
          "value": "complete"
        }
      ],
      "required": true
    },
    {
      "id": "R3",
      "claim": "one immutable review envelope exists before any governed lens slot starts",
      "record": "context",
      "check": "before",
      "select": {"kind": "review_envelope"},
      "before": "first_dispatch_or_collection",
      "required": true
    },
    {
      "id": "R4",
      "claim": "the ReviewKernel seals its shared context fingerprint before the first lens dispatch",
      "record": "trace",
      "check": "before",
      "select": {"event": "review_kernel_started", "context_fingerprint": {"present": true}},
      "before": "first_dispatch_or_collection",
      "required": true
    },
    {
      "id": "R5",
      "claim": "one selective routing decision dispositions the complete lens catalog and never widens to all",
      "record": "trace",
      "check": "all",
      "of": [
        {
          "check": "field_equals",
          "select": {"event": "review_kernel_started"},
          "field": "routing_mode",
          "value": "selective"
        },
        {
          "check": "field_equals",
          "select": {"event": "review_kernel_started"},
          "field": "routing_complete",
          "value": true
        },
        {
          "check": "field_equals",
          "select": {"event": "review_kernel_started"},
          "field": "dispositions_complete",
          "value": true
        }
      ],
      "required": true
    },
    {
      "id": "R6",
      "claim": "every dispatched leased slot returns exactly one canonical slot result",
      "record": "dispatch",
      "check": "pairs",
      "select": {"kind": "review-kernel-slot"},
      "with": {"record": "context", "select": {"kind": "slot_result"}},
      "key": "slot_id",
      "allow_empty_with": {"record": "trace", "select": {
        "event": "review_kernel_started", "routing_complete": true,
        "slots": []}},
      "required": true
    },
    {
      "id": "R7",
      "claim": "diff and impact are derived once and every slot cites the same immutable envelope",
      "record": "derivations",
      "check": "all",
      "of": [
        {
          "record": "derivations",
          "check": "repeats",
          "select": {"event": "derived", "probe": {"absent": true}},
          "distinct_by": ["key", "input_key"],
          "max": 0
        },
        {
          "record": "dispatch",
          "check": "pairs",
          "select": {"kind": "review-kernel-slot"},
          "with": {"record": "context", "select": {"kind": "review_envelope"}},
          "key": {"left": "context_fingerprint", "right": "fingerprint"},
          "allow_empty_with": {"record": "trace", "select": {
            "event": "review_kernel_started", "routing_complete": true,
            "slots": []}}
        }
      ],
      "universal": ["no_rederive"],
      "required": true
    },
    {
      "id": "R8",
      "claim": "the review contract and readiness precede dispatch, and canonical collection closes the review before sign-off",
      "record": "trace",
      "check": "all",
      "of": [
        {"check": "before", "select": {"event": "contract_activated"}, "before": "first_dispatch_or_collection"},
        {"check": "before", "select": {"event": "dor", "ready": true}, "before": "first_dispatch_or_collection"},
        {"check": "exists", "select": {"event": "review_kernel_collected"}}
      ],
      "universal": ["contract", "dor", "dod"],
      "required": true
    }
  ]
}
