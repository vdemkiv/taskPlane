{
  "schema": "taskplane.skill-flow/v1",
  "skill": "tp-status",
  "approval": {"status": "human-approved", "scope": "all-10", "date": "2026-08-14"},
  "settings": {"source": "taskplane/operational-settings.json", "loader": "taskplane.settings.load_settings", "binding": "settings_digest"},
  "stage_runtime": {"dispatch_schema":"taskplane.stage-dispatch/v1","startup_schema":"taskplane.stage-startup/v1","handoff_schema":"taskplane.stage-handoff/v1","bounded_inputs":["authority","input_handoff","selected_artifacts","budget","declared_scope","execution_claim"],"forbidden_inheritance":["agents","conversations","event_logs","tool_transcripts","leases","runtime_state","predecessor_roots"],"non_build_terminal_outcomes":["closed","discarded"],"implicit_build":false,"rollout_modes":["new-run","enabled"],"rollback":"retain-v4-read-only-no-reverse-migration"},
  "nodes": [
    {"id": "request", "label": "status request", "kind": "input"},
    {"id": "manifest", "label": "bounded stage + handoff + lineage", "kind": "parallel"},
    {"id": "state", "label": "loop + task state", "kind": "parallel"},
    {"id": "requirements", "label": "requirements + debt", "kind": "parallel"},
    {"id": "graph", "label": "dependency graph", "kind": "parallel"},
    {"id": "view", "label": "mission-control dashboard", "kind": "visual"},
    {"id": "action", "label": "action banner / no action", "kind": "stage"}
  ],
  "edges": [["request", "manifest"], ["request", "state"], ["request", "requirements"], ["request", "graph"], ["manifest", "view"], ["state", "view"], ["requirements", "view"], ["graph", "view"], ["view", "action"]]
}
