      "design_edges": [
        "taskplane/review.py->contract:review-kernel-slot:consumes",
        "taskplane/review_evidence.py->contract:review-evidence-binding:provides",
        "taskplane/review_repair.py->contract:review-kernel-mechanical-repair:provides",
        "taskplane/review_recovery.py->contract:review-kernel-mechanical-repair:consumes",
