{
  "schema": "taskplane.skill-flow/v1",
  "skill": "tp-go",
  "approval": {"status": "human-approved", "scope": "all-10", "date": "2026-08-14"},
  "stage_runtime": {
    "dispatch_schema": "taskplane.stage-dispatch/v1",
    "startup_schema": "taskplane.stage-startup/v1",
    "handoff_schema": "taskplane.stage-handoff/v1",
    "bounded_inputs": ["authority", "input_handoff", "selected_artifacts", "budget", "declared_scope", "execution_claim"],
    "forbidden_inheritance": ["agents", "conversations", "event_logs", "tool_transcripts", "leases", "runtime_state", "predecessor_roots"],
    "non_build_terminal_outcomes": ["closed", "discarded"],
    "implicit_build": false,
    "rollout_modes": ["new-run", "enabled"],
    "rollback": "retain-v4-read-only-no-reverse-migration"
  },
  "rollout_policy": {
    "canary": {
      "mode": "new-run",
      "exact_run_count": 1,
      "named_owner_required": true,
      "owner_source": "stage_authority.actor"
    },
    "observation": {
      "minimum_hours": 24,
      "retro_required": true
    },
    "abort": {
      "threshold": 1,
      "signals": [
        "predecessor_root_open",
        "ambiguous_active_projection",
        "terminal_reopen_attempt",
        "handoff_integrity_failure",
        "authority_mismatch",
        "startup_bound_exceeded",
        "migration_conservation_mismatch",
        "r0003_cleanup_proof_failure"
      ]
    },
    "rollback": {
      "maximum_minutes": 15,
      "action": "disable-v4-mutations-retain-v4-read-only"
    }
  },
  "nodes": [
    {"id": "goal", "label": "goal + loop init", "kind": "input"},
    {"id": "product", "label": "Product · minimum-sufficient quick", "kind": "stage"},
    {"id": "design", "label": "Design · minimum-sufficient quick", "kind": "stage"},
    {"id": "plan", "label": "Plan · exactly 3–4 quick", "kind": "stage"},
    {"id": "authorization", "label": "consolidated pre-implementation authorization", "kind": "gate"},
    {"id": "build", "label": "scoped Build/Fix · zero lenses", "kind": "parallel"},
    {"id": "evaluate", "label": "Evaluate · exactly 3–4 quick", "kind": "parallel"},
    {"id": "engineering", "label": "Engineering · consume Evaluate evidence", "kind": "stage"},
    {"id": "signoff", "label": "final sign-off", "kind": "gate"},
    {"id": "retro", "label": "retro + graph true-up", "kind": "stage"}
  ],
  "edges": [["goal", "product"], ["product", "design"], ["design", "plan"], ["plan", "authorization"], ["authorization", "build"], ["build", "evaluate"], ["evaluate", "engineering"], ["engineering", "signoff"], ["signoff", "retro"]]
}
