{
  "schema": "taskplane.skill-flow/v1",
  "skill": "tp-engineering",
  "approval": {
    "status": "human-approved",
    "scope": "native source review simplification",
    "date": "2026-09-14"
  },
  "settings": {
    "source": "taskplane/operational-settings.json",
    "loader": "taskplane.settings.load_settings",
    "binding": "settings_digest"
  },
  "stage_runtime": {
    "dispatch_schema": "taskplane.stage-dispatch/v1",
    "startup_schema": "taskplane.stage-startup/v1",
    "handoff_schema": "taskplane.stage-handoff/v1",
    "bounded_inputs": [
      "authority",
      "input_handoff",
      "selected_artifacts",
      "budget",
      "declared_scope",
      "execution_claim"
    ],
    "forbidden_inheritance": [
      "agents",
      "conversations",
      "event_logs",
      "tool_transcripts",
      "leases",
      "runtime_state",
      "predecessor_roots"
    ],
    "non_build_terminal_outcomes": [
      "closed",
      "discarded"
    ],
    "implicit_build": false,
    "default": "taskplane.run/v4",
    "applies_to": "explicit delivery only"
  },
  "nodes": [
    {
      "id": "manifest",
      "label": "explicit delivery dispatch only",
      "kind": "input"
    },
    {
      "id": "target",
      "label": "target pinned",
      "kind": "stage"
    },
    {
      "id": "diff",
      "label": "one diff + graph impact",
      "kind": "stage"
    },
    {
      "id": "quality",
      "label": "graph-quality gate",
      "kind": "stage"
    },
    {
      "id": "route",
      "label": "sealed direct Evaluate evidence",
      "kind": "stage"
    },
    {
      "id": "wave",
      "label": "zero-lens Engineering judgment",
      "kind": "stage"
    },
    {
      "id": "collect",
      "label": "canonical collection",
      "kind": "stage"
    },
    {
      "id": "dashboard",
      "label": "workflow + graph + findings",
      "kind": "visual"
    },
    {
      "id": "signoff",
      "label": "approve / request changes",
      "kind": "gate"
    },
    {
      "id": "terminal",
      "label": "stage terminal; no implicit child or cleanup",
      "kind": "stage"
    },
    {
      "id": "request",
      "label": "review request",
      "kind": "input"
    },
    {
      "id": "source",
      "label": "selected source and native tools",
      "kind": "stage"
    },
    {
      "id": "findings",
      "label": "findings, coverage and uncertainty",
      "kind": "stage"
    }
  ],
  "edges": [
    [
      "manifest",
      "target"
    ],
    [
      "target",
      "diff"
    ],
    [
      "diff",
      "quality"
    ],
    [
      "quality",
      "route"
    ],
    [
      "route",
      "wave"
    ],
    [
      "wave",
      "collect"
    ],
    [
      "collect",
      "dashboard"
    ],
    [
      "dashboard",
      "signoff"
    ],
    [
      "signoff",
      "terminal"
    ],
    [
      "request",
      "source"
    ],
    [
      "source",
      "findings"
    ],
    [
      "request",
      "manifest"
    ]
  ]
}
